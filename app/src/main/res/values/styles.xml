<resources>
  <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="colorPrimary">@color/brand_primary</item><item name="colorOnPrimary">@color/brand_on_primary</item>
    <item name="colorPrimaryContainer">@color/brand_container</item><item name="colorOnPrimaryContainer">@color/brand_on_container</item>
    <item name="colorSecondaryContainer">@color/brand_container</item><item name="colorOnSecondaryContainer">@color/brand_on_container</item>
    <item name="android:fontFamily">@font/urbanist</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    <item name="colorSurface">@color/app_surface</item>
    <item name="colorSurfaceContainerLow">@color/app_surface_low</item>
    <item name="colorSurfaceContainer">@color/app_surface_low</item>
    <item name="colorSurfaceContainerHigh">@color/app_surface_high</item>
    <item name="colorOnSurface">@color/app_on_surface</item>
    <item name="colorOnSurfaceVariant">@color/app_secondary_text</item>
    <item name="colorOutlineVariant">@color/app_outline</item>
  </style>
  <style name="PageTitle" parent="TextAppearance.Material3.TitleLarge">
    <item name="android:fontFamily">@font/urbanist</item>
    <item name="android:textStyle">bold</item>
  </style>
</resources>
